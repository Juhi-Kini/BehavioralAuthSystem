@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized>

        <div class="d-flex flex-column gap-1">

            <NavLink class="nav-link-vault"
                     href=""
                     Match="NavLinkMatch.All">

                <svg width="18" height="18" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a2 2 0 002 2h2a2 2 0 002-2v-4a1 1 0 00-1-1H9a1 1 0 00-1 1v4a2 2 0 002 2h6">
                    </path>
                </svg>

                <span>Dashboard</span>
            </NavLink>


            <NavLink class="nav-link-vault"
                     href="files">

                <svg width="18" height="18" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z">
                    </path>
                </svg>

                <span>Encrypted Vault</span>
            </NavLink>


            <NavLink class="nav-link-vault"
                     href="behavioral-actions">

                <span style="font-size:18px;">🧠</span>

                <span>Behavioral Actions</span>
            </NavLink>


            <NavLink class="nav-link-vault"
                     href="trash">

                <svg width="18" height="18" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                    </path>
                </svg>

                <span>Trash &amp; Purge</span>
            </NavLink>


            <NavLink class="nav-link-vault"
                     href="audit-analytics">

                <svg width="18" height="18" fill="none"
                     stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z">
                    </path>
                </svg>

                <span>Audit &amp; Analytics</span>
            </NavLink>


            <NavLink class="nav-link-vault"
                     href="profile">

                <span style="font-size:18px;">👤</span>

                <span>Profile</span>
            </NavLink>

        </div>

    </Authorized>

    <NotAuthorized>

        <div class="d-flex flex-column gap-1">

            <NavLink class="nav-link-vault"
                     href="login">

                <span style="font-size:18px;">🔐</span>

                <span>Login</span>
            </NavLink>


            <NavLink class="nav-link-vault"
                     href="register">

                <span style="font-size:18px;">📝</span>

                <span>Register</span>
            </NavLink>

        </div>

    </NotAuthorized>

</AuthorizeView>