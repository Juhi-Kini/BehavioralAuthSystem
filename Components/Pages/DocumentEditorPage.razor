@page "/editor"
@page "/editor/{FileId:int}"
@attribute [Authorize]
@implements IDisposable
@inject AuthenticationStateProvider AuthStateProvider
@inject IAuthService AuthService
@inject IFileStorageService FileStorageService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Document Editor - BehavioralAuthSystem</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-3">
        <div>
            <h3 class="m-0 text-primary">Rich Text Document Editor</h3>
            @if (activeFile != null)
            {
                <span class="badge bg-secondary-subtle text-secondary border">@activeFile.FileName</span>
            }
            else
            {
                <span class="badge bg-teal-subtle text-teal border border-teal-subtle">New Rich Text Document</span>
            }
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-vault-secondary btn-sm" @onclick="ExportPdf">Export PDF</button>
            <button type="button" class="btn btn-vault btn-sm" @onclick="RequestSaveDocument" disabled="@isSaving">
                @if (isSaving)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span><span>Encrypting &amp; Saving...</span>
                }
                else
                {
                    <span>Save &amp; Snapshot</span>
                }
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info py-2 px-3 small mb-3 d-flex justify-content-between align-items-center">
            <span>@statusMessage</span>
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <div class="vault-card mb-3 p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <input type="text" class="form-control form-control-sm form-control-vault" @bind="fileName" placeholder="Document Name (e.g. notes.md)" />
            </div>
            <div class="col-md-4 d-flex align-items-center gap-2">
                <input type="text" class="form-control form-control-sm form-control-vault" @bind="findText" placeholder="Find text..." />
                <input type="text" class="form-control form-control-sm form-control-vault" @bind="replaceText" placeholder="Replace..." />
                <button type="button" class="btn btn-vault-secondary btn-sm" @onclick="FindAndReplace">Replace</button>
            </div>
            <div class="col-md-4 text-end text-muted small">
                Words: <strong>@WordCount</strong> | Chars: <strong>@CharCount</strong> | <span class="text-teal">Saving requires verification</span>
            </div>
        </div>
    </div>

    @if (isMarkdown)
    {
        <div class="row g-3">
            <div class="col-md-6">
                <div class="vault-card p-2 h-100">
                    <label class="form-label small fw-semibold text-muted">Markdown Source</label>
                    <textarea class="form-control border-0 p-2" style="height:520px; font-family:var(--font-mono); resize:none; outline:none; background:transparent; color:var(--text-main);" @bind="documentContent" @bind:event="oninput" placeholder="Write your encrypted notes here..."></textarea>
                </div>
            </div>
            <div class="col-md-6">
                <div class="vault-card p-3 overflow-auto" style="height:555px;">
                    <label class="form-label small fw-semibold text-muted">Live Preview</label>
                    <div class="markdown-body p-2 border-top border-color">
                        @((MarkupString)Markdig.Markdown.ToHtml(documentContent ?? string.Empty))
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="vault-card p-3">
            <div class="rich-editor-toolbar-note mb-2">
                <span>Word-style formatting</span>
                <small>Choose font, size, color, alignment, lists and more from the toolbar.</small>
            </div>
            <div id="quill-editor" class="rich-document-editor"></div>
        </div>
    }

    @if (fileVersions.Count > 0)
    {
        <div class="vault-card mt-4 p-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="text-primary m-0 fw-bold">Encrypted Version History</h6>
                <span class="text-muted small">Previous snapshots</span>
            </div>
            <div class="d-flex gap-3 overflow-auto py-2">
                @foreach (var ver in fileVersions)
                {
                    <div class="border border-color rounded p-3 small" style="min-width:220px;">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-teal">v@ver.VersionNumber</span>
                            <span class="text-muted">@((ver.SizeBytes / 1024.0).ToString("F1")) KB</span>
                        </div>
                        <div class="text-muted mb-2">@ver.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</div>
                        <button type="button" class="btn btn-vault-secondary btn-sm w-100" @onclick="() => RequestRestoreSnapshot(ver.Id)">Restore v@ver.VersionNumber</button>
                    </div>
                }
            </div>
        </div>
    }
</div>


<ActionVerificationModal @bind-IsOpen="showActionModal"
                         CurrentUser="currentUser"
                         ActionType="@editorActionType"
                         OperationContext="@(FileId.HasValue ? $"Update file '{fileName}'" : "Create a new file")"
                         OnVerificationPassed="HandleEditorVerificationPassed" />

