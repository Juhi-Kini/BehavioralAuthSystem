@code {
    [Parameter] public int? FileId { get; set; }

    private User? currentUser;
    private FileRecord? activeFile;
    private bool showActionModal;
    private PendingEditorOperation pendingOperation = PendingEditorOperation.None;
    private int? pendingRestoreVersionId;
    private string editorActionType = "Create";
    private List<FileVersion> fileVersions = new List<FileVersion>();

    private string fileName = "confidential_document.html";
    private string documentContent = "# Confidential Research Notes\n\nThis document is protected with AES-256-GCM encryption.\n\n### Key Principles\n- Keystroke dynamics biometrics verify identity.\n- All snapshots are versioned and encrypted.";
    private string findText = string.Empty;
    private string replaceText = string.Empty;
    private string statusMessage = string.Empty;
    private bool isSaving = false;
    private bool isMarkdown => fileName.EndsWith(".md", StringComparison.OrdinalIgnoreCase) || fileName.EndsWith(".markdown", StringComparison.OrdinalIgnoreCase);
private enum PendingEditorOperation
{
    None,
    LoadExistingFile,
    Save,
    RestoreSnapshot
}
    private DotNetObjectReference<DocumentEditorPage>? dotNetRef;

    private int WordCount => (documentContent ?? string.Empty)
        .Split(new[] { ' ', '\r', '\n', '\t' }, StringSplitOptions.RemoveEmptyEntries).Length;
    private int CharCount => (documentContent ?? string.Empty).Length;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
        {
            currentUser = await AuthService.GetUserByUsernameAsync(state.User.Identity.Name!);
            if (currentUser != null && FileId.HasValue)
            {
                // Verify before decrypting/loading an existing document.
                editorActionType = "Update";
                pendingOperation = PendingEditorOperation.LoadExistingFile;
                showActionModal = true;
            }
        }
    }

    private async Task HandleEditorVerificationPassed()
    {
        showActionModal = false;

        var operation = pendingOperation;
        pendingOperation = PendingEditorOperation.None;

        switch (operation)
        {
            case PendingEditorOperation.LoadExistingFile:
                await LoadExistingFileAfterVerification();
                break;

            case PendingEditorOperation.Save:
                await SaveDocumentCore();
                break;

            case PendingEditorOperation.RestoreSnapshot:
                if (pendingRestoreVersionId.HasValue)
                    await RestoreSnapshotCore(pendingRestoreVersionId.Value);
                break;
        }
    }

    private async Task LoadExistingFileAfterVerification()
    {
        if (currentUser == null || !FileId.HasValue)
            return;

        var (isSuccess, msg, bytes, name, type) =
            await FileStorageService.DownloadFileAsync(currentUser, FileId.Value);

        if (isSuccess && bytes != null)
        {
            activeFile = await FileStorageService.GetFileByIdAsync(FileId.Value, currentUser.Id);
            fileName = name;
            documentContent = System.Text.Encoding.UTF8.GetString(bytes);
            fileVersions = await FileStorageService.GetFileVersionsAsync(FileId.Value, currentUser.Id);
            statusMessage = "Document loaded after behavioral verification.";
        }
        else
        {
            statusMessage = msg;
        }
    }

    private void RequestSaveDocument()
    {
        if (currentUser == null)
        {
            statusMessage = "You must be signed in before saving.";
            return;
        }

        if (isSaving)
            return;

        editorActionType = activeFile == null ? "Create" : "Update";
        pendingOperation = PendingEditorOperation.Save;
        showActionModal = true;
    }

    private void RequestRestoreSnapshot(int versionId)
    {
        if (currentUser == null || activeFile == null)
        {
            statusMessage = "Load a document before restoring a snapshot.";
            return;
        }

        pendingRestoreVersionId = versionId;
        editorActionType = "Restore";
        pendingOperation = PendingEditorOperation.RestoreSnapshot;
        showActionModal = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !isMarkdown)
        {
            try
            {
                dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("quillInterop.init", "quill-editor", documentContent, dotNetRef);
            }
            catch { }
        }
    }

    [JSInvokable]
    public void OnContentChanged(string content)
    {
        documentContent = content;
        StateHasChanged();
    }

    private void FindAndReplace()
    {
        if (!string.IsNullOrEmpty(findText) && documentContent != null)
        {
            documentContent = documentContent.Replace(findText, replaceText ?? string.Empty);
            statusMessage = $"Replaced occurrences of '{findText}' with '{replaceText}'.";
        }
    }

    private async Task SaveDocumentCore()
    {
        if (currentUser == null)
        {
            statusMessage = "You must be signed in before saving.";
            return;
        }
        isSaving = true;
        statusMessage = string.Empty;

        try
        {
            byte[] bytes = System.Text.Encoding.UTF8.GetBytes(documentContent ?? string.Empty);
            string contentType = isMarkdown ? "text/markdown" : "text/html";

            if (activeFile == null)
            {
                var (isSuccess, msg, record) = await FileStorageService.UploadFileAsync(currentUser, fileName, contentType, bytes);
                if (isSuccess && record != null)
                {
                    activeFile = record;
                    fileVersions = await FileStorageService.GetFileVersionsAsync(record.Id, currentUser.Id);
                    statusMessage = "Document created and encrypted successfully.";
                }
                else statusMessage = msg;
            }
            else
            {
                var (isSuccess, msg, version) = await FileStorageService.CreateVersionSnapshotAsync(currentUser, activeFile.Id, bytes);
                if (isSuccess)
                {
                    statusMessage = $"Document updated and version snapshot v{version?.VersionNumber} created!";
                    fileVersions = await FileStorageService.GetFileVersionsAsync(activeFile.Id, currentUser.Id);
                }
                else statusMessage = msg;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task RestoreSnapshotCore(int versionId)
    {
        if (currentUser == null || activeFile == null) return;

        var (isSuccess, msg) = await FileStorageService.RestoreVersionAsync(activeFile.Id, versionId, currentUser.Id);
        statusMessage = msg;

        if (isSuccess)
        {
            var (dlSuccess, dlMsg, bytes, name, type) = await FileStorageService.DownloadFileAsync(currentUser, activeFile.Id);
            if (dlSuccess && bytes != null)
            {
                documentContent = System.Text.Encoding.UTF8.GetString(bytes);
                fileVersions = await FileStorageService.GetFileVersionsAsync(activeFile.Id, currentUser.Id);
            }
        }
    }

    private async Task ExportPdf()
    {
        try
        {
            byte[] pdfBytes;
            using (var ms = new MemoryStream())
            {
                QuestPDF.Settings.License = QuestPDF.Infrastructure.LicenseType.Community;
                var doc = QuestPDF.Fluent.Document.Create(container =>
                {
                    container.Page(page =>
                    {
                        page.Margin(30);
                        page.Header().Text(fileName).FontSize(18).SemiBold();
                        page.Content().PaddingVertical(10).Text(documentContent ?? string.Empty).FontSize(10);
                        page.Footer().AlignCenter().Text(x => { x.Span("Page "); x.CurrentPageNumber(); });
                    });
                });
                doc.GeneratePdf(ms);

                pdfBytes = ms.ToArray();
            }

            string base64 = Convert.ToBase64String(pdfBytes);
            string pdfName = Path.ChangeExtension(fileName, ".pdf");
            await JS.InvokeVoidAsync("fileDownloadInterop.downloadFileFromBytes", pdfName, "application/pdf", base64);
            statusMessage = $"Exported PDF document '{pdfName}'.";
        }
        catch (Exception ex)
        {
            statusMessage = $"PDF export error: {ex.Message}";
        }
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }
}
