@page "/share/{Token}"
@inject IShareLinkService ShareLinkService
@inject IJSRuntime JS

<PageTitle>Shared File Download - BehavioralAuthSystem</PageTitle>

<div class="container py-5" style="max-width: 540px;">
    <div class="vault-card">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-teal-subtle text-teal mb-3" style="width: 56px; height: 56px;">
                <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"></path>
                </svg>
            </div>
            <h3 class="text-primary mb-1">Shared Secure File</h3>
            <p class="text-muted small">Decrypted server-side on-the-fly via authorized token</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger py-2 px-3 small mb-4 d-flex align-items-start gap-2">
                <span>⚠️</span>
                <div>@errorMessage</div>
            </div>
        }

        @if (linkInfo != null && fileRecordInfo != null)
        {
            <div class="border border-color rounded p-3 mb-4 bg-body-tertiary">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="text-teal">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <span class="fw-bold fs-6 text-main">@fileRecordInfo.FileName</span>
                </div>
                <div class="d-flex justify-content-between text-muted small">
                    <span>Size: @FormatFileSize(fileRecordInfo.SizeBytes)</span>
                    <span>Type: @fileRecordInfo.ContentType</span>
                </div>
                @if (linkInfo.ExpiresAt.HasValue)
                {
                    <div class="text-warning small mt-2 d-flex align-items-center gap-1">
                        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <span>Expires: @linkInfo.ExpiresAt.Value.ToString("yyyy-MM-dd HH:mm UTC")</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(linkInfo.SharePasswordHash))
            {
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Passcode Required:</label>
                    <input type="password" class="form-control form-control-vault" @bind="inputPassword" placeholder="Enter share passcode..." />
                </div>
            }

            <button class="btn btn-vault w-100 py-2 d-flex align-items-center justify-content-center gap-2" @onclick="DownloadSharedFile" disabled="@isDownloading">
                @if (isDownloading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Decrypting & Preparing Download...</span>
                }
                else
                {
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                    </svg>
                    <span>Decrypt & Download Original File</span>
                }
            </button>
        }
        else if (isChecking)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted small mt-2">Validating cryptographic share token...</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private ShareLink? linkInfo;
    private FileRecord? fileRecordInfo;
    private string inputPassword = string.Empty;
    private string errorMessage = string.Empty;
    private bool isChecking = true;
    private bool isDownloading = false;

    protected override async Task OnInitializedAsync()
    {
        var (isValid, msg, link, file) = await ShareLinkService.ValidateTokenAsync(Token);
        isChecking = false;

        if (isValid && link != null && file != null)
        {
            linkInfo = link;
            fileRecordInfo = file;
        }
        else
        {
            errorMessage = msg;
        }
    }

    private async Task DownloadSharedFile()
    {
        isDownloading = true;
        errorMessage = string.Empty;

        try
        {
            var (isSuccess, msg, bytes, fileName, contentType) = await ShareLinkService.AccessShareLinkAsync(Token, inputPassword);
            if (isSuccess && bytes != null)
            {
                string base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("fileDownloadInterop.downloadFileFromBytes", fileName, contentType, base64);
            }
            else
            {
                errorMessage = msg;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Download error: {ex.Message}";
        }
        finally
        {
            isDownloading = false;
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024) return $"{(bytes / (1024.0 * 1024.0)):F2} MB";
        return $"{(bytes / 1024.0):F1} KB";
    }
}
