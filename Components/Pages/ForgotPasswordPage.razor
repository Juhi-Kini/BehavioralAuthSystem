@page "/forgot-password"
@inject IJSRuntime JS
@inject IAuthService AuthService
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Forgot Password - BehavioralAuthSystem</PageTitle>

<div class="container py-5" style="max-width: 620px;">
    <div class="vault-card p-4 p-md-5">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-teal-subtle text-teal mb-3" style="width:56px;height:56px;">
                <span style="font-size:26px;">✉️</span>
            </div>
            <h2 class="text-primary mb-1">Forgot Password</h2>
            <p class="text-muted small mb-0">
                Verify your recovery email and enroll a new password typing rhythm.
            </p>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="alert @(isError ? "alert-danger" : "alert-info") small">@message</div>
        }

        @if (!codeSent)
        {
            <div class="mb-3">
                <label class="form-label fw-semibold small">Recovery Email</label>
                <input type="email"
                       class="form-control form-control-vault"
                       @bind="email"
                       placeholder="you@example.com"
                       disabled="@isBusy" />
            </div>

            <button class="btn btn-vault w-100" @onclick="SendCode" disabled="@isBusy">
                @(isBusy ? "Sending verification code..." : "Send Verification Code")
            </button>
        }
        else
        {
            <div class="alert alert-success small">
                A 6-digit verification code was sent to your recovery email. The code expires in 10 minutes.
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold small">Verification Code</label>
                <input class="form-control form-control-vault"
                       @bind="code"
                       maxlength="6"
                       inputmode="numeric"
                       placeholder="Enter 6-digit code"
                       disabled="@isBusy" />
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold small">New Password</label>
                    <input type="password"
                           class="form-control form-control-vault"
                           @bind="newPassword"
                           placeholder="Minimum 6 characters"
                           disabled="@isBusy" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-semibold small">Confirm Password</label>
                    <input type="password"
                           class="form-control form-control-vault"
                           @bind="confirmPassword"
                           placeholder="Repeat password"
                           disabled="@isBusy" />
                </div>
            </div>

            <div class="border-top border-color pt-3 mt-3">
                <h6 class="text-teal fw-bold mb-1">Re-enroll Password Typing Rhythm</h6>
                <p class="text-muted small">
                    Password recovery also refreshes your login biometric profile. Type the new password naturally four times.
                </p>

                <div class="input-group mb-2">
                    <input id="reset-pwd-input"
                           type="password"
                           class="form-control form-control-vault"
                           value="@sampleInput"
                           @oninput="OnSampleInput"
                           placeholder="Type the new password for sample @(samples.Count + 1) of 4"
                           disabled="@(isBusy || string.IsNullOrWhiteSpace(newPassword) || samples.Count >= 4)" />

                    <button class="btn btn-vault-secondary"
                            type="button"
                            @onclick="RecordSample"
                            disabled="@(isBusy || string.IsNullOrWhiteSpace(sampleInput) || samples.Count >= 4)">
                        Record @(samples.Count + 1)
                    </button>
                </div>

                <div class="waveform-box mb-3">
                    <svg id="reset-pwd-input-waveform" style="width:100%;height:100%;"></svg>
                </div>

                <div class="d-flex justify-content-between text-muted small">
                    <span>Samples recorded: @samples.Count / 4</span>
                    @if (samples.Count == 4)
                    {
                        <span class="text-success fw-semibold">✓ Ready</span>
                    }
                </div>
            </div>

            <button class="btn btn-vault w-100 mt-4"
                    @onclick="ResetPassword"
                    disabled="@(isBusy || samples.Count < 4)">
                @(isBusy ? "Resetting Password..." : "Verify Email & Reset Password")
            </button>

            <button class="btn btn-link w-100 mt-2"
                    @onclick="SendCode"
                    disabled="@isBusy">
                Send a new code
            </button>
        }

        <div class="text-center mt-4 pt-3 border-top border-color">
            <a href="/login" class="small text-primary fw-semibold text-decoration-none">← Return to Login</a>
        </div>
    </div>
</div>

@code {
    private string email = string.Empty;
    private string code = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string sampleInput = string.Empty;
    private string message = string.Empty;
    private bool isError;
    private bool isBusy;
    private bool codeSent;
    private bool captureAttached;

    private readonly List<KeystrokeSample> samples = new();
    private DotNetObjectReference<ForgotPasswordPage>? dotNetRef;

    private async Task SendCode()
    {
        if (string.IsNullOrWhiteSpace(email))
        {
            ShowError("Enter your recovery email address.");
            return;
        }

        isBusy = true;
        message = string.Empty;

        try
        {
            var result = await AuthService.RequestPasswordResetAsync(email.Trim());
            codeSent = result.Success;
            if (result.Success)
                ShowInfo(result.Message);
            else
                ShowError(result.Message);
        }
        catch (Exception ex)
        {
            ShowError($"Unable to send verification code: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OnSampleInput(ChangeEventArgs e)
    {
        sampleInput = e.Value?.ToString() ?? string.Empty;
    }

    private async Task RecordSample()
    {
        message = string.Empty;

        if (string.IsNullOrWhiteSpace(newPassword) || newPassword.Length < 6)
        {
            ShowError("Enter the new password first.");
            return;
        }

        if (sampleInput != newPassword)
        {
            ShowError("The typed sample does not match the new password.");
            sampleInput = string.Empty;
            await JS.InvokeVoidAsync("keystrokeCapture.reset", "reset-pwd-input");
            return;
        }

        try
        {
            var data = await JS.InvokeAsync<KeystrokeSample>(
                "keystrokeCapture.getTimingData",
                "reset-pwd-input");

            if (data == null || data.HoldTimes.Count == 0)
            {
                ShowError("No keystroke timings were captured. Type the password directly in the field.");
                return;
            }

            samples.Add(data);
            sampleInput = string.Empty;
            await JS.InvokeVoidAsync("keystrokeCapture.reset", "reset-pwd-input");
            ShowInfo($"Sample {samples.Count} recorded.");
        }
        catch (Exception ex)
        {
            ShowError($"Sample capture error: {ex.Message}");
        }
    }

    private async Task ResetPassword()
    {
        if (newPassword != confirmPassword)
        {
            ShowError("The new password and confirmation do not match.");
            return;
        }

        if (samples.Count < 4)
        {
            ShowError("Please complete all 4 password typing samples.");
            return;
        }

        isBusy = true;
        message = string.Empty;

        try
        {
            var result = await AuthService.ResetPasswordAsync(
                email.Trim(),
                code.Trim(),
                newPassword,
                samples);

            if (result.Success)
            {
                await DetachCapture();
                Navigation.NavigateTo("/login");
                return;
            }

            ShowError(result.Message);
        }
        catch (Exception ex)
        {
            ShowError($"Password reset failed: {ex.Message}");
        }
        finally
        {
            isBusy = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (codeSent && !captureAttached)
        {
            captureAttached = true;
            dotNetRef ??= DotNetObjectReference.Create(this);

            try
            {
                await JS.InvokeVoidAsync(
                    "keystrokeCapture.attach",
                    "reset-pwd-input",
                    dotNetRef);
            }
            catch
            {
                captureAttached = false;
            }
        }
    }

    private async Task DetachCapture()
    {
        if (!captureAttached)
            return;

        try
        {
            await JS.InvokeVoidAsync("keystrokeCapture.detach", "reset-pwd-input");
        }
        catch { }

        captureAttached = false;
    }

    private void ShowError(string text)
    {
        isError = true;
        message = text;
    }

    private void ShowInfo(string text)
    {
        isError = false;
        message = text;
    }

    public async ValueTask DisposeAsync()
    {
        await DetachCapture();
        dotNetRef?.Dispose();
    }
}
